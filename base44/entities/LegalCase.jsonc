{
  "name": "LegalCase",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "title": "Cliente ID"
    },
    "client_name": {
      "type": "string",
      "title": "Nome do Cliente"
    },
    "client_phone": {
      "type": "string",
      "title": "Telefone do Cliente"
    },
    "case_number": {
      "type": "string",
      "title": "N\u00famero do Processo"
    },
    "area": {
      "type": "string",
      "enum": [
        "C\u00edvel",
        "Criminal",
        "Trabalhista",
        "Fam\u00edlia",
        "Tribut\u00e1rio",
        "Empresarial",
        "Previdenci\u00e1rio",
        "Outro"
      ],
      "title": "\u00c1rea Jur\u00eddica"
    },
    "type": {
      "type": "string",
      "enum": [
        "A\u00e7\u00e3o",
        "Audi\u00eancia",
        "Recurso",
        "Consulta",
        "Reuni\u00e3o",
        "Prazo",
        "Dilig\u00eancia"
      ],
      "title": "Tipo"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "time": {
      "type": "string",
      "title": "Hor\u00e1rio"
    },
    "court": {
      "type": "string",
      "title": "Vara / Tribunal"
    },
    "status": {
      "type": "string",
      "enum": [
        "Agendado",
        "Realizado",
        "Pendente",
        "Cancelado",
        "Encerrado"
      ],
      "title": "Status"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "client_name",
    "date",
    "type",
    "status"
  ]
}